{
	"name": "drago-ex/texy-toolbar",
	"description": "Texy for Nette: safe HTML with highlighted code blocks, a toolbar with a preview for the textarea and a copy button, with Bootstrap 5 classes.",
	"type": "library",
	"license": "MIT",
	"authors": [
		{
			"name": "Zdeněk Papučík",
			"homepage": "https://github.com/accgit"
		}
	],
	"require": {
		"php": ">=8.3 <9",
		"texy/texy": "^3.2",
		"nette/di": "^3.2",
		"nette/http": "^3.3",
		"nette/utils": "^4.0",
		"nette/schema": "^1.2"
	},
	"require-dev": {
		"nette/tester": "^2.5",
		"phpstan/phpstan-nette": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"Drago\\": "src"
		}
	},
	"extra": {
		"drago-translator": {
			"translation": "src/Texy/Translate"
		}
	},
	"scripts": {
		"phpstan": "phpstan analyse",
		"tester": "tester tests -s -C"
	}
}
